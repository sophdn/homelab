# jellyfin.env.example — copy to jellyfin.env (gitignored, chmod 600) and fill in.
#
# Read by jellyfin/scripts/media_ingest.py to trigger a library scan after an
# ingest. It is NOT an env_file for the compose stack; the Jellyfin container
# itself needs no secrets.
#
#   cp jellyfin/env/jellyfin.env.example jellyfin/env/jellyfin.env
#   chmod 600 jellyfin/env/jellyfin.env
#
# The key is read straight into the request header and is never printed or
# logged. With no key configured, ingest still completes and prints the manual
# "Dashboard -> Libraries -> Scan All Libraries" fallback instead of failing.

# Dedicated least-privilege API key. Create it in the Jellyfin Dashboard under
# API Keys -> "+", named `media-ingest`. Do NOT reuse a user session token: a
# named key can be revoked on its own without logging anyone out.
JELLYFIN_API_KEY=

# Optional. Defaults to http://mini-pc:8096 (the tailnet name). Override
# for the LAN address if the tailnet is not up.
#JELLYFIN_URL=http://mini-pc.local:8096
